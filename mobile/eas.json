{
  "cli": {
    "version": ">= 10.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      }
    },
    "preview": {
      "distribution": "internal",
      "withoutCredentials": true,
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleDebug",
        "artifactPath": "android/app/build/outputs/apk/**/*.apk"
      },
      "ios": {
        "distribution": "internal"
      }
    }
  },
  "submit": {}
}
